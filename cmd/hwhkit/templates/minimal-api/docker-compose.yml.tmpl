services:
  postgres:
    image: postgres:16-alpine
    profiles: ["postgres"]
    environment:
      POSTGRES_DB: {{.ProjectName}}
      POSTGRES_USER: app
      POSTGRES_PASSWORD: app
    ports: ["5432:5432"]

  redis:
    image: redis:7-alpine
    profiles: ["redis"]
    ports: ["6379:6379"]

  jaeger:
    image: jaegertracing/all-in-one:1.60
    profiles: ["jaeger"]
    ports:
      - "16686:16686"
      - "4317:4317"
